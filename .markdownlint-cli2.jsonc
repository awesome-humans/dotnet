{
  // Markdown linting for this repository. Run via `just lint` or `just check`, which use the
  // versions pinned in package.json — never `npx markdownlint-cli2` (see AGENTS.md).
  // Formatting is prettier's job (--prose-wrap preserve); this file only turns
  // off the rules that conflict with that or misfire on our content.
  "config": {
    "default": true,

    // Prose is one sentence per line, unwrapped — prettier preserves it and the
    // diffs stay readable. A hard column limit would conflict with that on every edit.
    "MD013": false,

    // Misfires on headings that legitimately end in "#": "# C#", "## Testing F#".
    // markdownlint reads the trailing # as closed-atx syntax. No way to satisfy
    // it without renaming the languages.
    "MD020": false,
  },
  "globs": ["**/*.md"],
  // .claude/skills is a local symlink to skills/ (see AGENTS.md: Skills), and
  // markdownlint follows symlinks, so linting it reports every finding twice.
  // artifacts/site holds the pages `just verify` stages, generated from files
  // already linted at source.
  "ignores": ["node_modules", ".claude", "artifacts"],
}
