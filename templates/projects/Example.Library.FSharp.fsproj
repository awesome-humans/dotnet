<!-- awesome-humans/dotnet template | targets: net10.0, fsharp-10 | last-reviewed: 2026-08-14 | sources: ms-learn -->
<!-- An F# project inherits the same settings from Directory.Build.props. F# compiles files in the order listed below. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- F# 10 parallel compilation is still a preview feature. Uncomment the property to adopt it (opinions/fsharp.md).
    <ParallelCompilation>true</ParallelCompilation> -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

</Project>
