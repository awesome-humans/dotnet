<!-- Test project on Microsoft.Testing.Platform with xUnit v3. `dotnet test` runs it through the
     runner opt-in in global.json. Don't add TestingPlatformDotnetTestSupport: it's the VSTest
     bridge, which MTP v2 (xunit.v3 4.0.0) rejects on the .NET 10 SDK. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Keeps solution-level publish output for deployment only. Without it, the test host and a
         second copy of every referenced library go into artifacts/publish (opinions/ci.md). -->
    <IsPublishable>false</IsPublishable>
    <!-- Required: xunit.v3 test projects build to an executable under
         Microsoft.Testing.Platform, and the build fails without this. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- house:simon-mckenna begin -->
    <!-- **House:** CA1707 (no underscores in member names) contradicts the test-naming
         convention UnitOfWork_Scenario_ExpectedBehaviour (opinions/testing.md). The
         convention wins in test projects, and CA1707 still applies to shipping code. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- house:simon-mckenna end -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../../src/Example.Library/Example.Library.csproj" />
  </ItemGroup>

</Project>
