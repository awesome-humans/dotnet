<!-- From the .NET 10 SDK, `dotnet new sln` creates an SLNX file by default. -->
<Solution>
  <Folder Name="/src/">
    <Project Path="src/Example.Library/Example.Library.csproj" />
    <Project Path="src/Example.Library.FSharp/Example.Library.FSharp.fsproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Example.Library.Tests/Example.Library.Tests.csproj" />
  </Folder>
  <!-- house:simon-mckenna begin -->
  <!-- **House:** The IDE shows the root build files under /build/, beside the projects they configure. -->
  <Folder Name="/build/">
    <File Path="Directory.Build.props" />
    <File Path="Directory.Build.targets" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path=".editorconfig" />
  </Folder>
  <!-- house:simon-mckenna end -->
</Solution>
