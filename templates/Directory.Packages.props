<!-- awesome-humans/dotnet template | targets: net11.0 | last-reviewed: 2026-11-14 | sources: dotnet-blog, meziantou, ms-learn -->
<!-- Central Package Management: every PackageReference in the repository takes its version from here. -->
<!-- Versions verified against nuget.org (latest stable) on 2026-11-14. Refresh them with the refresh-dotnet-versions skill. -->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Framework extensions">
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <!-- Held at 10.0.15, not latest stable, until Asp.Versioning.OpenApi ships for .NET 11.
         10.2.3 needs Microsoft.OpenApi below 3.0.0, and 11.0.0 of this package needs 3.11.0
         or later, so restore fails with NU1107 (opinions/aspnet-core.md, Review by 2027-02-28). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Validation" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.340" />
  </ItemGroup>

  <!-- No Microsoft.Testing.Platform entry: xunit.v3 brings its own compatible version.
       Pinning MTP separately overrides it through transitive pinning, and fails at run time
       with a TypeLoadException (opinions/testing.md). The risk is higher since xunit.v3
       4.0.0, which dropped MTP v1 and defaults to v2. -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="Meziantou.Framework.SnapshotTesting" Version="3.1.21" />
    <!-- WebApplicationFactory<T> for integration tests, and FakeTimeProvider for
         deterministic time. opinions/testing.md requires both. Without a pin here, a consumer
         who follows the opinion gets NU1010 on restore, because CPM leaves the
         PackageReference with no version. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- A Native AOT test lane references xunit.v3.aot.mtp-v2 in place of xunit.v3
         (opinions/testing.md). Keep the two on the same version. -->
    <PackageVersion Include="xunit.v3.aot.mtp-v2" Version="4.0.3" />
  </ItemGroup>

</Project>
