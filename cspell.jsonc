{
  // Spell checking for this repository. Run via `npm run spell` or `npm run check`,
  // which use the version pinned in package.json. Editors with a cspell extension
  // read this file too, so the editor and CI flag the same words.
  "version": "0.2",

  // British spelling, per AGENTS.md: Spelling. en-US would flag every
  // "behaviour"; the flagWords below catch the American forms en-GB misses.
  "language": "en-GB",
  "dictionaries": [
    "dotnet",
    "csharp",
    "fsharp",
    "softwareTerms",
    "npm",
    "bash",
    "repository-words",
  ],

  // Names, identifiers, and terms the dictionaries lack. addWords lets the
  // editor's "add to dictionary" action write here.
  "dictionaryDefinitions": [
    {
      "name": "repository-words",
      "path": "./cspell.words.txt",
      "addWords": true,
    },
  ],

  "useGitignore": true,
  // .claude/skills is a local symlink to skills/, and artifacts/site is generated
  // from files already checked at source (see .markdownlint-cli2.jsonc).
  // The others are machine-written.
  "ignorePaths": [
    "node_modules",
    ".claude",
    "artifacts",
    "package-lock.json",
    ".github/state",
    "assets/diagrams",
  ],

  "overrides": [
    {
      // Skip what AGENTS.md: Scope of these rules keeps as written: link text
      // (usually a third-party title), inline code (an identifier someone else
      // named), a quotation, and a product name in American spelling.
      "filename": "**/*.md",
      "ignoreRegExpList": [
        "/\\[[^\\]\\n]*\\]\\(/g",
        "/`[^`\\n]+`/g",
        "/\"[^\"\\n]*\"/g",
        "/Azure Architecture Center/g",
      ],
      // The .NET dictionaries accept these because API names use them
      // (Behavior, Color), so en-GB alone lets them through in prose. Code
      // files aren't covered: an identifier keeps the platform's spelling.
      // cspell:disable
      "flagWords": [
        "behavior",
        "behaviors",
        "behavioral",
        "color",
        "colors",
        "colored",
        "defense",
        "defenses",
        "catalog",
        "catalogs",
        "modeling",
        "modeled",
        "favor",
        "favors",
        "favorite",
        "honor",
        "center",
        "centered",
        "analyze",
        "analyzed",
        "analyzes",
        "analyzing",
        "practiced",
        "canceled",
        "canceling",
        "labeled",
        "labeling",
        "traveled",
        "fulfill",
        "judgment",
        "gray",
      ],
      // cspell:enable
    },
  ],
}
